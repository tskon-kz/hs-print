# Epson network endpoint. Confirm the exact IPP path during the preflight stage.
PRINTER_URI=ipp://192.168.1.207/ipp/print

# CUPS queue and the name shown to iPhone/iPad users.
PRINTER_NAME=Epson-L3250
AIRPRINT_NAME=Epson L3250 — Дом
PRINTER_PRODUCT=Epson L3250

# Optional CUPS driver identifier. Leave empty for automatic discovery. The
# current printer-driver-escpr package exposes the identifier below.
PRINTER_MODEL=escpr:0/cups/model/epson-inkjet-printer-escpr/Epson-L3250_Series-epson-escpr-en.ppd

# Trusted LAN permitted to submit and administer print jobs.
LAN_SUBNET=192.168.1.0/24

# Used by containers for timestamps and logs.
TZ=Europe/Moscow
