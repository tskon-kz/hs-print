<?xml version="1.0" standalone='no'?><!-- $Id$ -->
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name>${AIRPRINT_NAME}</name>
  <service>
    <type>_ipp._tcp</type>
    <subtype>_universal._sub._ipp._tcp</subtype>
    <port>631</port>
    <txt-record>txtvers=1</txt-record>
    <txt-record>qtotal=1</txt-record>
    <txt-record>rp=printers/${PRINTER_NAME}</txt-record>
    <txt-record>ty=${PRINTER_PRODUCT}</txt-record>
    <txt-record>product=(${PRINTER_PRODUCT})</txt-record>
    <txt-record>pdl=application/pdf,image/urf,image/jpeg</txt-record>
    <txt-record>URF=V1.4,W8,SRGB24,CP1,IS1,MT1-3-4-5,DM1</txt-record>
    <txt-record>Color=T</txt-record>
    <txt-record>Duplex=F</txt-record>
    <txt-record>Scan=F</txt-record>
    <txt-record>PaperMax=legal-A4</txt-record>
    <txt-record>priority=10</txt-record>
  </service>
</service-group>
